{
  "model_type": "multimodal_remote_sensing_adapter",
  "base_architecture": "Vision-Transformer-Remote-Sensing-DualStream",
  "peft_type": "LORA_ADAPTER",
  "task_type": "MULTIMODAL_CLASSIFICATION_AND_GROUNDING",
  "lora_rank": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "target_modules": [
    "optical_stem.7",
    "sar_stem.7",
    "fusion_gate.0",
    "fusion_gate.3",
    "classifier"
  ],
  "embed_dim": 256,
  "optical_channels": 3,
  "sar_channels": 2,
  "num_classes": 19,
  "classes": [
    "Urban fabric",
    "Industrial or commercial units",
    "Arable land",
    "Permanent crops",
    "Pastures",
    "Complex cultivation patterns",
    "Land principally occupied by agriculture",
    "Broad-leaved forest",
    "Coniferous forest",
    "Mixed forest",
    "Natural grassland and sparsely vegetated areas",
    "Moors, heathland and sclerophyllous vegetation",
    "Transitional woodland, shrub",
    "Beaches, dunes, sands",
    "Inland wetlands",
    "Coastal wetlands",
    "Inland waters",
    "Marine waters",
    "Continuous and discontinuous urban fabric"
  ],
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "contrastive_temperature": 0.1,
  "dataset_provenance": "BigEarthNet.txt (TU Berlin / ESA Sentinel-1 SAR + Sentinel-2 Optical)",
  "hardware_target": "CPU_AND_CUDA_AGNOSTIC"
}
